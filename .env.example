# Proof Gatekeeper — environment template.
# Copy to .env and fill in REAL values. Never commit .env.
# The HMAC secret is the platform-generated 32-byte secret from the Agent
# Games dashboard ("Rotate Secret"). It is shown exactly once — never use a
# local placeholder in production; the server refuses to start without it.

# REQUIRED — platform-generated HMAC secret (32 bytes; hex, base64, or raw string).
AGENT_GAMES_HMAC_SECRET=

# Kurier API key (https://kurier.xyz). Only used when ZKVERIFY_MODE=kurier.
KURIER_API_KEY=

# Port the HTTP server listens on.
PORT=3000

# local = generate + verify the Groth16 proof locally only, no network
# submission (DEFAULT — safe). kurier = also submit to zkVerify via Kurier.
ZKVERIFY_MODE=local

# true = only APPROVE when Kurier reports Finalized within the poll budget.
# false = accept the response once Kurier has a txHash (Submitted).
# See README "Unverified protocol details" — the platform requirement here
# is unverified; default is the fail-closed choice.
REQUIRE_FINALIZED=true

# task_id -> field element mapping. sha256 (default; only option with
# practice-task evidence) or keccak256 (contested — see README).
TASK_ID_HASH=sha256

# Salt derivation scheme. Only supported value today:
#   hmac:<HMAC(secret, "gatekeeper-salt:"+task_id) mod p>
# The derivation itself is an UNVERIFIED participant convention.
SALT_DERIVATION=hmac

# --- Optional tuning (defaults are sane; only change deliberately) ---
# KURIER_BASE_URL=https://api.kurier.xyz/api/v1
# KURIER_POLL_BUDGET_MS=20000
# KURIER_POLL_INTERVAL_MS=2000
# REQUEST_TIMEOUT_MS=60000
# MAX_TASK_AGE_MS=600000
# CLOCK_SKEW_MS=300000
# CIRCUIT_DIR=
