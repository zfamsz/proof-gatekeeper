.env
.env.*
!.env.example
node_modules/
dist/
# Large circuit binaries — never committed. The Dockerfile downloads them
# from the official URLs at build time and verifies SHA-256 (see README).
circuits/*.wasm
circuits/*.zkey
# Keep the exported verification key (small, derived locally) — it is NOT
# ignored. Only the wasm/zkey above are excluded.
*.log
.DS_Store
